# Copie para .env e preencha. Nunca faça commit do .env.

# --- Claude ---
ANTHROPIC_API_KEY=
# Modelo e esforço. O esforço controla quanto o modelo "pensa" (low | medium | high).
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFORCO=medium

# --- WhatsApp Business Platform (Cloud API da Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e cadastra no painel da Meta para validar o webhook.
WHATSAPP_VERIFY_TOKEN=
# "App secret" do app na Meta; usado para conferir a assinatura de cada webhook.
WHATSAPP_APP_SECRET=
# Use a versão atual da Graph API indicada no painel da Meta.
WHATSAPP_API_VERSAO=v23.0

# --- Escritório ---
ESCRITORIO_CONFIG=escritorio.json

# --- Painel / avisos ---
# Token exigido no cabeçalho X-Painel-Token para ler e alterar casos pela API.
PAINEL_TOKEN=
# Opcional: URL que recebe um POST com a ficha quando um caso fica pronto
# ou precisa de humano (ex.: webhook do n8n, Make ou Slack).
AVISO_WEBHOOK_URL=

# --- Funcionamento ---
BANCO=dados/atendimento.db
# Espera alguns segundos para juntar mensagens enviadas em sequência (ex.: 3 fotos).
AGRUPAR_SEGUNDOS=4
