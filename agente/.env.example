# Copie para .env e preencha. Nunca faça commit do .env.

# --- Claude ---
ANTHROPIC_API_KEY=
# Modelo e esforço. O esforço controla quanto o modelo "pensa" (low | medium | high).
# Haiku 5.5 é o padrão pelo custo; compare com claude-opus-5-5 nas conversas de teste.
CLAUDE_MODELO=claude-haiku-5-5
CLAUDE_ESFORCO=high

# --- WhatsApp Business Platform (Cloud API da Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e cadastra no painel da Meta para validar o webhook.
WHATSAPP_VERIFY_TOKEN=
# "App secret" do app na Meta; usado para conferir a assinatura de cada webhook.
WHATSAPP_APP_SECRET=
# Use a versão atual da Graph API indicada no painel da Meta.
WHATSAPP_API_VERSAO=v23.0

# --- Escritório ---
ESCRITORIO_CONFIG=escritorio.json

# --- Painel do advogado ---
# Senha do painel (/painel) e da API (cabeçalho X-Painel-Token). Use um texto longo e aleatório.
PAINEL_TOKEN=
# Endereço público do servidor, usado nos links dos avisos (ex.: https://agente.seudominio.com.br).
PAINEL_URL=

# --- Avisos por e-mail (opcional) ---
# Ex.: Gmail/Google Workspace com "senha de app", ou o SMTP do seu provedor de e-mail.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
AVISO_EMAIL_DE=
# Um ou mais e-mails da equipe, separados por vírgula.
AVISO_EMAIL_PARA=

# --- Avisos por webhook (opcional) ---
# URL que recebe um POST com a ficha (ex.: webhook do n8n, Make ou Slack).
AVISO_WEBHOOK_URL=

# --- Funcionamento ---
BANCO=dados/atendimento.db
PASTA_DOCUMENTOS=dados/documentos
# Espera alguns segundos para juntar mensagens enviadas em sequência (ex.: 3 fotos).
AGRUPAR_SEGUNDOS=4
